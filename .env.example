# ==============================================================================
# QUORUM ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env for local overrides.
# For Render deployment, configure these variables in Render Service Settings.

# Network Binding Configuration
# Render automatically injects PORT (e.g. 10000). Default fallback is 3000.
PORT=3000

# Host network binding. Set to 0.0.0.0 for container / cloud deployment.
# In production / Render, Quorum automatically binds to 0.0.0.0.
HOST=0.0.0.0

# Node execution environment (development | production | test)
NODE_ENV=production

# Frontend Origin URL(s) for Controlled CORS
# Multiple origins can be specified comma-separated without trailing slashes.
# Examples:
#   Local development:  http://localhost:5173
#   Production:         https://quorum-app.vercel.app,https://quorum.onrender.com
FRONTEND_URL=http://localhost:5173

# Optional alias for FRONTEND_URL
# FRONTEND_ORIGIN=http://localhost:5173

# SQLite Storage Path (Optional)
# Defaults to server/data/quorum.db
# When using Render Persistent Disks, specify mount path (e.g., /var/data/quorum.db)
# DATABASE_PATH=/var/data/quorum.db

# Artifacts Storage Directory (Optional)
# Defaults to server/data/artifacts/
# When using Render Persistent Disks, specify mount path (e.g., /var/data/artifacts)
# ARTIFACTS_DIR=/var/data/artifacts

# GitHub REST API Token (Optional)
# Highly recommended to increase public GitHub rate limits from 60 req/hr to 5,000 req/hr.
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
